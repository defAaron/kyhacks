# SurplusLink — copy to .env and fill in secrets
# See docs/TRD.md §10

DATABASE_URL="file:./dev.db"
AUTH_SECRET=                          # required — e.g. openssl rand -base64 32
AUTH_URL="http://localhost:3000"      # optional; Auth.js v5 also accepts trustHost
GEMINI_API_KEY=
NEXT_PUBLIC_DEFAULT_CITY_LAT=38.2527
NEXT_PUBLIC_DEFAULT_CITY_LNG=-85.7585

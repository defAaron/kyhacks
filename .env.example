# SurplusLink — copy to .env and fill in secrets
# See docs/TRD.md §10

# Local SQLite (dev only — Prisma schema uses postgresql for Supabase/Vercel).
# For local Postgres/Supabase, paste your connection string instead.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require"

# Prefer the Supabase "Transaction" pooler URI on Vercel (port 6543), e.g.:
# DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL="postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require"

AUTH_SECRET=                          # required — e.g. openssl rand -base64 32
AUTH_URL="http://localhost:3000"      # production: https://your-app.vercel.app

# Optional: force data-URL photo storage (default on Vercel)
# UPLOAD_STRATEGY=data-url

# Local Food-101 vision budgets (CPU guard; no paid API)
VISION_MIN_INTERVAL_MS=3000
VISION_MAX_PER_USER_PER_MINUTE=3
VISION_MAX_PER_USER_PER_HOUR=10
VISION_MAX_PER_USER_PER_DAY=40
VISION_MAX_GLOBAL_PER_DAY=200

NEXT_PUBLIC_DEFAULT_CITY_LAT=38.2527
NEXT_PUBLIC_DEFAULT_CITY_LNG=-85.7585

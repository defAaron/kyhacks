# SurplusLink — copy to .env and fill in secrets
# See docs/TRD.md §10

DATABASE_URL="file:./dev.db"
AUTH_SECRET=                          # required — e.g. openssl rand -base64 32
AUTH_URL="http://localhost:3000"      # optional; Auth.js v5 also accepts trustHost
GEMINI_API_KEY=

# Gemini Vision budgets (skip API + fall back to manual entry when exceeded)
GEMINI_MIN_INTERVAL_MS=3000
GEMINI_MAX_PER_USER_PER_MINUTE=3
GEMINI_MAX_PER_USER_PER_HOUR=10
GEMINI_MAX_PER_USER_PER_DAY=20
GEMINI_MAX_GLOBAL_PER_DAY=50

NEXT_PUBLIC_DEFAULT_CITY_LAT=38.2527
NEXT_PUBLIC_DEFAULT_CITY_LNG=-85.7585

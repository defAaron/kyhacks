# SurplusLink — copy to .env
# Docs: docs/setup/SUPABASE.md · docs/setup/DEPLOYMENT.md

# Supabase Transaction pooler (app + Vercel) — port 6543, user postgres.<project-ref>
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Supabase direct (prisma db push) — port 5432, user postgres
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres?sslmode=require"

AUTH_SECRET=                          # required — openssl rand -base64 32
AUTH_URL="http://localhost:3000"      # production: https://kyhacks.vercel.app

# Optional
# UPLOAD_STRATEGY=data-url
VISION_MIN_INTERVAL_MS=3000
VISION_MAX_PER_USER_PER_MINUTE=3
VISION_MAX_PER_USER_PER_HOUR=10
VISION_MAX_PER_USER_PER_DAY=40
VISION_MAX_GLOBAL_PER_DAY=200

NEXT_PUBLIC_DEFAULT_CITY_LAT=38.2527
NEXT_PUBLIC_DEFAULT_CITY_LNG=-85.7585

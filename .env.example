# SurplusLink — copy to .env and fill in secrets
# See docs/TRD.md §10

DATABASE_URL="file:./dev.db"
AUTH_SECRET=                          # required — e.g. openssl rand -base64 32
AUTH_URL="http://localhost:3000"      # optional; Auth.js v5 also accepts trustHost

# Local Food-101 vision budgets (CPU guard; no paid API)
VISION_MIN_INTERVAL_MS=3000
VISION_MAX_PER_USER_PER_MINUTE=3
VISION_MAX_PER_USER_PER_HOUR=10
VISION_MAX_PER_USER_PER_DAY=40
VISION_MAX_GLOBAL_PER_DAY=200

NEXT_PUBLIC_DEFAULT_CITY_LAT=38.2527
NEXT_PUBLIC_DEFAULT_CITY_LNG=-85.7585

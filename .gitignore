# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.cursor/

# env files (keep .env.example committed)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma / sqlite
*.db
*.db-journal
/prisma/*.db
/prisma/*.db-journal

# local uploads (keep directory via .gitkeep)
/public/uploads/*
!/public/uploads/.gitkeep

# persisted vision daily quota counters + local model cache
/.data/
/.cache/
